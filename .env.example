# Server-only configuration. Copy to a gitignored local environment file.
DATABASE_URL=
WEB_ORIGINS=http://localhost:3016
PORT=

# Missing, zero, or malformed caps disable provider requests.
PROVIDER_DAILY_LIMIT=
PROVIDER_ACCOUNT_DAILY_LIMIT=
# Zero disables every project-funded AI, transcription, and hosted TTS request.
PROVIDER_MONTHLY_SPEND_CAP_CENTS=500
PROVIDER_BILLING_CAP_CONFIRMED=
PROVIDER_TERMS_REVIEWED=

# Tutor provider calls stay disabled unless every reviewed gate is configured.
# These are server-only values; never expose them through NEXT_PUBLIC_*.
TUTOR_PROVIDER_ENABLED=
TUTOR_PROVIDER=
TUTOR_MODEL=
OPENAI_API_KEY=
TUTOR_BILLING_CAP_CONFIRMED=
TUTOR_TERMS_REVIEWED=
TUTOR_PROJECT_DAILY_REQUEST_LIMIT=
TUTOR_ACCOUNT_DAILY_REQUEST_LIMIT=
TUTOR_PROJECT_DAILY_TOKEN_LIMIT=
TUTOR_ACCOUNT_DAILY_TOKEN_LIMIT=

# Provisional provider direction; no provider adapter or candidate voice enabled.
AUDIO_PROVIDER=
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=
AUDIO_PROVIDER_MODEL_VERSION=
AUDIO_PROVIDER_REVIEWED_VOICE_IDS=

# Intended Neon Object Storage adapter, explicit opt-in after provisioning review.
AUDIO_STORAGE_ENABLED=
AUDIO_STORAGE_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Server-owned JSON: max four stable entries; each requires id, label, locale
# ko-KR, modelVersion, sampleAssetId, auditionApproved and licensingReviewed.
# An entry also requires reviewed cached sample metadata, reviewed provider
# terms/training use, confirmed provider billing hard stop, and valid daily caps.
AUDIO_CATALOG_ENABLED=
AUDIO_REVIEWED_VOICES=

# OpenRouter Eleven v4 Turbo (Jessica/Chris) and Whisper Large V3.
# Key stays server-only. The API fails closed when the key or cap is missing.
OPENROUTER_API_KEY=
OPENROUTER_AUDIO_ENABLED=
# Learner-approved shared ceiling: $5/month. 500 cents = $5.00.
# Keep the shared billing/terms gates unset until deployment config is reviewed.

# Public API origin only; never put provider or storage secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=

# Optional hosted AI. Server-only values; never add these to NEXT_PUBLIC_*.
# Keep Workers Free; confirmation is an operator assertion, not a billing-plan API check.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FREE_PLAN_CONFIRMED=
SPEECH_PROVIDER=
FREE_AI_PROJECT_DAILY_LIMIT=200
FREE_AI_ACCOUNT_DAILY_LIMIT=25

# Optional Google sign-in through Firebase Spark. Disabled until server setup is approved.
# Service-account JSON is a private server secret; never use a NEXT_PUBLIC_ prefix.
FIREBASE_AUTH_ENABLED=false
FIREBASE_SPARK_PLAN_CONFIRMED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase web configuration is public. Supply all four only when ready to offer Google sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
