{
  "name": "sori-korean-learning",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "node scripts/local-run.cjs web",
    "dev:api": "node scripts/local-run.cjs api",
    "build": "npm run build:web && npm run build:api",
    "build:free": "node scripts/build-free-site.cjs",
    "build:web": "npm --workspace @sori/web run build",
    "build:api": "npm --workspace @sori/api run build",
    "start:web": "npm --workspace @sori/web run start",
    "start:api": "npm --workspace @sori/api run start:prod",
    "db:migrate": "node scripts/migrate.cjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:seed:words": "npm --workspace @sori/api run db:seed:words",
    "test": "node --test tests/*.test.cjs",
    "speech:local": "node scripts/start-local-speech.cjs",
    "build:local-speech": "node scripts/build-local-speech-site.cjs",
    "dev:local:web": "node scripts/local-full.cjs web",
    "dev:local:api": "node scripts/local-full.cjs api",
    "tutor:local": "node scripts/start-local-tutor.cjs",
    "dev:local": "concurrently -n tutor,speech,api,web \"npm:tutor:local\" \"npm:speech:local\" \"npm:dev:local:api\" \"npm:dev:local:web\"",
    "audio:prepare": "node scripts/prepare-lesson-audio.cjs",
    "audio:check": "node scripts/check-lesson-audio.cjs",
    "site:configure": "node scripts/configure-public-site.cjs",
    "build:hosted": "node scripts/build-hosted-site.cjs",
    "perf:startup": "node scripts/measure-startup.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "neon": "^8.3.4"
  },
  "dependencies": {
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3"
  },
  "overrides": {
    "neon": {
      "@hono/node-server": "2.0.10",
      "diff": "5.2.2"
    }
  }
}
